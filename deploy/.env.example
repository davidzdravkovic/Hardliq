# Copy to .env and fill in values before deploying.
# Generate JWT key: openssl rand -base64 48

POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=change_me_strong_db_password

# Must be at least 32 characters.
JWT_KEY=change_me_generate_a_long_random_secret_key

# Public URL users open in the browser (no trailing slash).
# Examples: http://203.0.113.10  or  https://tasks.example.com
PUBLIC_ORIGIN=http://YOUR_VPS_IP

