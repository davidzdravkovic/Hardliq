# Copy to .env and fill in values before deploying.
# Generate JWT key: openssl rand -base64 48
# Standalone compose (db + api + web): POSTGRES_* create that stack's Postgres.
# VPS compose.vps.yaml: POSTGRES_* must be infra's admin; Host=postgres on network database.
# Do not start web/db on the VPS — infra nginx serves dist/; infra Postgres stores data.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=taskmanager

# Must be at least 32 characters. Not ChatMe JWT_SECRET.
JWT_KEY=

# Browser origin (no trailing slash). VPS: https://taskspace.duckdns.org
PUBLIC_ORIGIN=https://taskspace.duckdns.org

